{
  /**
   * The shipping half: everything under `src/`, including the specs that sit
   * next to their modules. Extends two bases — the Svelte one for how `.svelte`
   * files are compiled and resolved, and ours for how strictly all of it is
   * checked. Ours comes second, so it wins where they overlap.
   */
  "extends": ["@tsconfig/svelte/tsconfig.json", "./tsconfig.base.json"],
  "compilerOptions": {
    "types": ["svelte", "vite/client"],
    "allowArbitraryExtensions": true,
    /**
     * Typecheck JS in `.svelte` and `.js` files by default.
     * Disable checkJs if you'd like to use dynamic types in JS.
     * Note that setting allowJs false does not prevent the use
     * of JS in `.svelte` files.
     */
    "allowJs": true,
    "checkJs": true
  },
  "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.svelte"]
}

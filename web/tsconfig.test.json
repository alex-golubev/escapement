{
  /**
   * `web/tests/` — the specs that have no module to sit beside, and the fakes
   * and helpers the suites share. Everything under `src/` is checked by the app
   * project instead, specs included.
   */
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    /**
     * `WebAssembly` is declared in lib.dom and nowhere else — @types/node does
     * not provide it. The tests run under Node and touch no DOM API beyond
     * that one namespace; the lib is here for it alone.
     */
    "lib": ["ES2023", "DOM"],
    "types": ["node"],

    /* Bundler mode: Vitest resolves these files through Vite. */
    "module": "preserve"
  },
  "include": ["tests/**/*.ts"]
}

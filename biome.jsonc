{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    // Keep "recommended". `biome migrate` rewrites this to "none", which
    // disables every rule while the command still reports success.
    "rules": { "preset": "recommended" }
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "asNeeded" }
  },
  "overrides": [
    {
      // Generated files are reviewed as the generator's output. Line wrapping
      // is the formatter's taste and would move whenever a field is added, so
      // the formatter stays out; the linter does not, because a finding here
      // is a finding about the generator.
      "includes": ["**/generated.ts"],
      "formatter": { "enabled": false }
    }
  ],
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": { "enabled": true }
  }
}

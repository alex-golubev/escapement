# Cargo.lock and pnpm-lock.yaml are committed on purpose: this workspace builds
# applications, so exact dependency versions have to be reproducible.

# --- Rust ---
target/
**/*.rs.bk
*.pdb
# cargo-fuzz
fuzz/target/
fuzz/corpus/
fuzz/artifacts/
# wasm-pack / wasm-bindgen output
pkg/
wasm-pack.log

# --- Node ---
node_modules/
.pnpm-store/
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
*.log

# --- Build output ---
dist/
build/
.vite/
*.tsbuildinfo

# --- Tests and coverage ---
coverage/
.nyc_output/

# --- Environment and secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12

